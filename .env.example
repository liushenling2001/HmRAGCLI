APP_NAME=HmRAGCLI API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hmrag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen2.5-3b-instruct
AI_REQUEST_TIMEOUT_SECONDS=300
AI_REQUEST_MAX_RETRIES=1
AI_EXTRACT_CHUNK_LIMIT=8
ASYNC_ENHANCE_AFTER_INGEST=true
INGEST_BUILD_MAX_WORKERS=3
STALE_PROCESSING_SECONDS=180
ENHANCEMENT_WORKER_POLL_SECONDS=2
ENHANCEMENT_QUEUE_MAX_PENDING=12
ENHANCEMENT_QUEUE_FILL_BATCH_SIZE=4
EMBEDDING_CHUNK_LIMIT_PER_FILE=120
PDF_PREVIEW_PAGE_LIMIT=5
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_REQUEST_TIMEOUT_SECONDS=300
LIBREOFFICE_PATH=soffice
PARSE_MODE=auto
ENHANCED_PARSER_BACKEND=none
ENHANCED_PDF_SIZE_KB=512
ENHANCED_DOCX_SIZE_KB=256
SEARCH_KEYWORD_WEIGHT=0.7
SEARCH_UNIT_VECTOR_WEIGHT=0.8
SEARCH_UNIT_VECTOR_BOOST=0.4
SEARCH_CHUNK_KEYWORD_WEIGHT=0.65
SEARCH_CHUNK_VECTOR_WEIGHT=0.85
SEARCH_CHUNK_VECTOR_BOOST=0.45
SEARCH_EXACT_PHRASE_BOOST=0.9
SEARCH_TITLE_HIT_BOOST=0.35
SEARCH_FILENAME_HIT_BOOST=0.2
SEARCH_SUMMARY_HIT_BOOST=0.18
SEARCH_CAPTION_HIT_BOOST=0.22
SEARCH_DOC_DEV_TITLE_PENALTY=0.18
SEARCH_DOC_DEV_TEXT_PENALTY=0.06
SEARCH_DOC_CODE_BLOCK_PENALTY=0.08
SEARCH_DOC_TABLE_PENALTY=0.05
SEARCH_DOC_LINK_PENALTY=0.03
SEARCH_DOC_MAX_NOISE_PENALTY=0.4
SEARCH_DOC_MIN_NOISE_PENALTY=-0.08
SEARCH_QUERY_ASCII_MISS_PENALTY=0.85
SEARCH_QUERY_NON_ASCII_MISS_PENALTY=0.12
SEARCH_QUERY_HIT_BONUS=0.05
SEARCH_QUERY_MAX_HIT_BONUS=0.12
